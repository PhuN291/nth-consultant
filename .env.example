# ────────────────────────────────────────────────────────────────────
# Accounting-Hub backend env
# Copy file này thành `.env` và điền giá trị thật.
# ────────────────────────────────────────────────────────────────────

# Postgres connection string (Neon free tier)
# Lấy ở: https://console.neon.tech → project → Connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Secret để ký session cookie. Random ≥32 ký tự.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Cloudinary URL (lưu ảnh blog).
# Lấy ở: https://console.cloudinary.com/ → Dashboard → "API Environment variable"
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Tài khoản admin đầu tiên — chỉ dùng khi chạy `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# Port server (mặc định 5000, project đang dùng 5050)
PORT=5050
