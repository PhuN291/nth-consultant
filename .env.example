# ────────────────────────────────────────────────────────────────────
# NTH Consulting — environment variables
# Copy file này thành `.env` và điền giá trị thật.
# ────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────
# Dùng cho docker-compose — tạo container postgres tự động
POSTGRES_DB=nth_consultant
POSTGRES_USER=nth_user
POSTGRES_PASSWORD=change-this-strong-password

# DATABASE_URL được docker-compose tự ghép từ 3 biến trên.
# Chỉ cần set thủ công nếu chạy Node trực tiếp (không qua compose):
# DATABASE_URL=postgresql://nth_user:change-this-strong-password@localhost:5432/nth_consultant

# ── Session ──────────────────────────────────────────────────────────
# Random ≥32 ký tự. Sinh nhanh:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# ── Cloudinary (lưu ảnh blog) ────────────────────────────────────────
# Lấy ở: https://console.cloudinary.com/ → Dashboard → "API Environment variable"
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Seed admin (chỉ dùng khi chạy `npm run db:seed` lần đầu) ─────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me

# ── Server ───────────────────────────────────────────────────────────
PORT=5050
